:root {
}

.panel {
}

.unity-button {
    background-color: rgb(0, 170, 6);
    -unity-font-definition: url("project://database/Assets/Fonts/Chillax-Semibold.otf?fileID=12800000&guid=2dc95e5a239daf147bf7a87c51c7fd28&type=3#Chillax-Semibold");
    font-size: 29px;
    padding-top: 2.5px;
    padding-bottom: 2.5px;
    padding-left: 3px;
    padding-right: 3px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-bottom-left-radius: 3px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    border-left-color: rgb(182, 255, 75);
    border-right-color: rgb(182, 255, 75);
    border-top-color: rgb(182, 255, 75);
    border-bottom-color: rgb(182, 255, 75);
    background-size: 100% 100%;
}

.unity-button:hover {
    background-color: rgb(88, 249, 94);
    background-size: 120% 120%;
    width: auto;
    height: auto;
    transform-origin: center;
    transition-property: scale;
    transition-duration: 0.25s;
    scale: 1.05 1.05;
}
